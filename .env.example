# Hedera testnet credentials
# Create a testnet account at https://portal.hedera.com/ (free, funded with test HBAR). The private key below belongs to the paying client only; the gateway itself never needs a key, because the facilitator pays the fee.

# Account that RECEIVES payment. Used by the gateway.
HEDERA_PAY_TO_ACCOUNT_ID=0.0.xxxxxxx

# Account that SENDS payment. Used by the client/reference agent only. Server-side only. Never sent to a browser, never logged, never bundled into frontend assets
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=302e0201...

# x402
# Production and bounty validation MUST use Blocky402:
#   https://api.testnet.blocky402.com   (testnet)
#   https://api.blocky402.com           (mainnet)
# The official facilitator (https://x402.org/facilitator) is for local
# development only; a run against it is not proof of bounty qualification.
FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet

# Price per protected call, in HBAR.
PRICE_PING=0.01
PRICE_VERIFY=0.02

# Public gateway port. The only public origin.
PORT=4021

# Internal analysis service
ANALYSIS_SERVICE_URL=http://127.0.0.1:8099
ANALYSIS_HOST=127.0.0.1
ANALYSIS_PORT=8099

MAX_UPLOAD_BYTES=10485760

# Reference agent (hosted judge flow)
AGENT_ACCOUNT_ID=0.0.xxxxxxx
AGENT_PRIVATE_KEY=0x...

# Internal address of the reference agent. Loopback only.
AGENT_SERVICE_URL=http://127.0.0.1:4022
AGENT_HOST=127.0.0.1
AGENT_PORT=4022

# The gateway's public URL, as the agent reaches it from outside.
# PRODUCTION: set this to the real external https origin. Leaving it as
# loopback after deploy means the reference agent stops exercising the same
# public path a third-party agent would (CLAUDE.md Section 17).
GATEWAY_PUBLIC_URL=http://127.0.0.1:4021

# Persistent SQLite location. In Docker this is a mounted volume; the default
# sits beside the code and would be lost on every container replacement.
DATABASE_URL=/data/proofline.db

# Host port the gateway publishes (compose only).
PUBLIC_PORT=4021

# Abuse controls for the server-funded /demo/verify path. Each demo call
# spends real HBAR from AGENT_ACCOUNT_ID, so this endpoint is metered.
# The developer path (/verify) is not: that caller pays for themselves.
DEMO_RATE_LIMIT_PER_MINUTE=12
DEMO_MAX_CONCURRENT=2
DEMO_TIMEOUT_MS=120000
