# Single-Machine Fly image: gateway + reference agent + analysis service.

# --- stage 1: frontend --------------------------------------------------- 
FROM node:22-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* .
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- stage 2: runtime -------------------------------------------------------
FROM node:22-slim

# python3 + tesseract for the forensic engine; supervisor to run PID 
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv tesseract-ocr supervisor \
    && rm -rf /var/lib/apt/lists/*

# Debian marks the system Python externally-managed, so use a venv rather than --break-system-packages.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /srv

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY x402-gate/package.json x402-gate/package-lock.json* ./x402-gate/
RUN cd x402-gate \
    && npm ci --omit=dev \
    && npm install --no-save tsx@4.19.2 \
    && npm cache clean --force

COPY backend/ ./backend/
COPY x402-gate/ ./x402-gate/
COPY --from=frontend /build/dist /srv/frontend/dist

# Judge samples are gitignored and generated, so they must be baked in or the CLEAR/REVIEW buttons 400 on a fresh deploy.
RUN python backend/make_test_docs.py

COPY deploy/supervisord.conf /etc/supervisor/conf.d/proofline.conf

ENV NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    ANALYSIS_HOST=127.0.0.1 \
    ANALYSIS_PORT=8099 \
    ANALYSIS_SERVICE_URL=http://127.0.0.1:8099 \
    AGENT_HOST=127.0.0.1 \
    AGENT_PORT=4022 \
    AGENT_SERVICE_URL=http://127.0.0.1:4022 \
    CORPUS_DIR=/srv/backend/test_docs \
    DATABASE_URL=/data/proofline.db

EXPOSE 8080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
